generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Book {
  slug                String    @id
  title               String
  subtitle            String?
  seriesName          String?
  volumeNumber        Int?
  genre               String
  tags                String
  shortDescription    String
  fullSynopsis        String
  releaseDate         String
  isbn                String?
  language            String    @default("English")
  pages               Int?
  readingTime         String?
  status              String    @default("published")
  coverUrl            String?
  bannerUrl           String?
  trailerLink         String?
  samplePdfUrl        String?
  previewUrl          String?
  awards              String?
  isFeatured          Boolean   @default(false)
  isBestseller        Boolean   @default(false)
  isEditorsChoice     Boolean   @default(false)
  displayOrder        Int       @default(0)
  seoTitle            String?
  seoDescription      String?
  socialShareImage    String?
  authorNotes         String?
  ageRating           String?
  contentWarning      String?
  lastUpdated         DateTime  @default(now()) @updatedAt
  amazonLink          String?
  googlePlayLink      String?
  appleBooksLink      String?
  koboLink            String?
  paperbackLink       String?
  hardcoverLink       String?
  officialWebsiteLink String?
  customLink          String?
  createdAt           DateTime  @default(now())
  audibleLink         String?
  kukuFmLink          String?
  pocketFmLink        String?
  storytelLink        String?
  comments            Comment[]

  @@index([status])
  @@index([genre])
  @@index([isFeatured])
  @@index([displayOrder])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  status    String   @default("active")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String?
  role         String    @default("user")
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     Comment[]
  sessions     Session[]

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id          String   @id @default(cuid())
  body        String
  status      String   @default("approved")
  postId      String?
  bookSlug    String?
  userId      String?
  authorName  String?
  authorEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  book        Book?    @relation(fields: [bookSlug], references: [slug], onDelete: Cascade)
  post        Post?    @relation(fields: [postId], references: [slug], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([postId])
  @@index([bookSlug])
}

model Post {
  slug           String    @id
  title          String
  excerpt        String
  content        String
  category       String    @default("Chronicles")
  tags           String
  coverUrl       String?
  status         String    @default("published")
  publishedAt    DateTime? @default(now())
  readingTime    String?
  authorName     String    @default("Nobi Kumar")
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  comments       Comment[]

  @@index([status])
  @@index([category])
  @@index([publishedAt])
}
